<Application x:Class="NanoImpact.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- 원본 비트맵 스킨 대신 표준 컨트롤 + 어두운 색 (영상이 잘 보이게) -->
        <SolidColorBrush x:Key="ShellBack" Color="#FF202326"/>
        <SolidColorBrush x:Key="PaneBack" Color="#FF2B2F33"/>
        <SolidColorBrush x:Key="PaneBorder" Color="#FF464C52"/>
        <SolidColorBrush x:Key="PaneHeader" Color="#FF34393E"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFE6E8EA"/>
        <SolidColorBrush x:Key="TextDim" Color="#FF9BA3AB"/>
        <SolidColorBrush x:Key="Accent" Color="#FF3D8BD9"/>
        <SolidColorBrush x:Key="ImageBack" Color="#FF323232"/>

        <Style x:Key="PaneTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="8,3"/>
        </Style>
        <Style x:Key="Pane" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PaneBack}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PaneBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style x:Key="InfoStrip" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="TopValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,12,0"/>
        </Style>
        <Style x:Key="TopLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="64"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
