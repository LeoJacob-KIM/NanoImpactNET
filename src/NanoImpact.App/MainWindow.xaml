<Window x:Class="NanoImpact.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:NanoImpact.App.Shell"
        Title="NanoImpact2020cfe" Width="1600" Height="960" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ShellBack}"
        Foreground="{StaticResource TextMain}">
    <!-- 원본 메인 화면 영역: 상단 도구 막대 / 1st·2nd·3rd·4th 영상 / 오른쪽 제어 탭 / Stage·CFE-HV·Navi / 아래 Detail·캡처 목록 -->
    <DockPanel>
        <!-- ===== 상단 도구 막대 (원본 m_TopTool*) ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PaneHeader}" BorderBrush="{StaticResource PaneBorder}" BorderThickness="0,0,0,1">
            <DockPanel Margin="6,4" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="NanoImpact" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="4,0,16,0"/>

                <!-- 진공 상태 (원본 DisplayVacuumStateInfo) -->
                <Border DockPanel.Dock="Left" x:Name="VacuumStateBox" CornerRadius="3" Padding="10,4" Margin="0,0,10,0" Background="#FF4A4F55" VerticalAlignment="Center" MinWidth="130">
                    <TextBlock x:Name="VacuumStateText" Text="VACUUM ---" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Border>
                <Button DockPanel.Dock="Left" x:Name="StartButton" Content="START" ToolTip="원본 상단 START (8단계 Vacuum/Beam 패널과 함께 연결)" IsEnabled="False"/>
                <Button DockPanel.Dock="Left" x:Name="StandbyButton" Content="STANDBY" IsEnabled="False"/>
                <Button DockPanel.Dock="Left" x:Name="AirButton" Content="AIR" IsEnabled="False"/>
                <Button DockPanel.Dock="Left" x:Name="EvacButton" Content="EVAC" IsEnabled="False" Margin="2,2,12,2"/>

                <TextBlock DockPanel.Dock="Left" Text="GUN HV" Style="{StaticResource TopLabel}"/>
                <ComboBox DockPanel.Dock="Left" x:Name="GunHVCombo" IsEnabled="False"/>
                <TextBlock DockPanel.Dock="Left" Text="MAG" Style="{StaticResource TopLabel}" Margin="10,0,0,0"/>
                <ComboBox DockPanel.Dock="Left" x:Name="MagCombo" IsEnabled="False" Margin="2,2,12,2"/>

                <Button DockPanel.Dock="Left" x:Name="AutoGunAlignButton" Content="GUN ALIGN" IsEnabled="False" ToolTip="9단계"/>
                <Button DockPanel.Dock="Left" x:Name="AutoCBButton" Content="AUTO C&amp;B" IsEnabled="False" ToolTip="9단계"/>
                <Button DockPanel.Dock="Left" x:Name="AutoFocusButton" Content="AUTO FOCUS" IsEnabled="False" ToolTip="9단계" Margin="2,2,12,2"/>

                <Button DockPanel.Dock="Right" x:Name="ExitButton" Content="EXIT" Click="OnExitClick"/>
                <Border DockPanel.Dock="Right" x:Name="SimBadge" Background="#FF8A5A00" CornerRadius="3" Padding="8,3" Margin="8,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="SIMULATOR" FontWeight="Bold"/>
                </Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FE HV" Style="{StaticResource TopLabel}"/>
                    <TextBlock x:Name="FEPowerStatusText" Text="---" Style="{StaticResource TopValue}"/>
                    <TextBlock Text="EXTRACTOR" Style="{StaticResource TopLabel}"/>
                    <TextBlock x:Name="ExtractorCurrentText" Text="---" Style="{StaticResource TopValue}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 상태 막대 ===== -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource PaneHeader}" Foreground="{StaticResource TextDim}">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Starting..."/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="StartStepText" Text="start step -"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="FrameRateText" Text="0.0 fps"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="ScanModeText" Text="scan -"/></StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="600"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 영상 영역 ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="300"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.3*" MinHeight="160"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1st 영상: 라이브 (RED/FAST/SLOW1/SLOW2) -->
                    <Border Grid.Column="0" Style="{StaticResource Pane}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Background="{StaticResource PaneHeader}">
                                <TextBlock Text="1st  LIVE" Style="{StaticResource PaneTitle}"/>
                                <TextBlock x:Name="FirstImageModeText" Text="" Style="{StaticResource PaneTitle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" x:Name="FirstImageInfoText" Style="{StaticResource InfoStrip}" Text=" "/>
                            <Grid Background="{StaticResource ImageBack}" ClipToBounds="True">
                                <Image x:Name="FirstImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <Viewbox Stretch="Uniform">
                                    <Canvas x:Name="FirstOverlay" Width="640" Height="480" IsHitTestVisible="False">
                                        <Rectangle x:Name="RedScanBox" Stroke="Red" StrokeThickness="2" Visibility="Collapsed"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- 2nd 영상: 포토 (PHOTO1~6) -->
                    <Border Grid.Column="1" Style="{StaticResource Pane}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Background="{StaticResource PaneHeader}">
                                <TextBlock Text="2nd  PHOTO" Style="{StaticResource PaneTitle}"/>
                                <TextBlock x:Name="SecondImageModeText" Text="" Style="{StaticResource PaneTitle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" x:Name="SecondImageInfoText" Style="{StaticResource InfoStrip}" Text=" "/>
                            <Grid Background="{StaticResource ImageBack}" ClipToBounds="True">
                                <Image x:Name="SecondImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 3rd 영상: 챔버 카메라 (10단계 TVideoGrabber) -->
                    <Border Grid.Column="0" Style="{StaticResource Pane}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="3rd  CAMERA" Style="{StaticResource PaneTitle}" Background="{StaticResource PaneHeader}"/>
                            <Grid Background="{StaticResource ImageBack}">
                                <Image x:Name="ThirdImage" Stretch="Uniform"/>
                                <TextBlock Text="chamber camera (step 10)" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- 4th 영상: 히스토그램 (원본 DrawHistogramGraph) -->
                    <Border Grid.Column="1" Style="{StaticResource Pane}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="4th  HISTOGRAM" Style="{StaticResource PaneTitle}" Background="{StaticResource PaneHeader}"/>
                            <shell:HistogramView x:Name="Histogram" Background="#FF1A1C1E" Margin="2"/>
                        </DockPanel>
                    </Border>

                    <!-- 아래: Detail / 캡처 목록 / 패널 호출 기록 -->
                    <Border Grid.Column="2" Style="{StaticResource Pane}">
                        <TabControl Background="{StaticResource PaneBack}" BorderThickness="0">
                            <TabItem Header="DETAIL">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl x:Name="DetailInfoList" Grid.Column="0" Margin="4" MinWidth="260">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Column="1" Margin="8" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                               Text="Detail control panel (step 8). Information lines from the image processor are listed on the left."/>
                                </Grid>
                            </TabItem>
                            <TabItem Header="CAPTURE LIST">
                                <ListBox x:Name="CaptureList" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0"/>
                            </TabItem>
                            <TabItem Header="PANEL CALLS">
                                <ListBox x:Name="PanelCallList" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0"
                                         FontFamily="Consolas" VirtualizingStackPanel.IsVirtualizing="True"/>
                            </TabItem>
                            <TabItem Header="LOG">
                                <ListBox x:Name="LogList" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0"
                                         FontFamily="Consolas" VirtualizingStackPanel.IsVirtualizing="True"/>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns"/>

            <!-- ===== 오른쪽: 제어 탭 / Stage·CFE-HV·Navi ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Pane}">
                    <TabControl x:Name="ControlTabs" Background="{StaticResource PaneBack}" BorderThickness="0">
                        <TabItem Header="SCAN">
                            <StackPanel Margin="8">
                                <TextBlock Text="Scan mode (temporary until the step 8 Scan panel)" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"/>
                                <WrapPanel x:Name="LiveScanButtons"/>
                                <TextBlock Text="Photo" Foreground="{StaticResource TextDim}" Margin="0,10,0,4"/>
                                <WrapPanel x:Name="PhotoScanButtons"/>
                                <Button x:Name="CaptureStopButton" Content="CAPTURE STOP" HorizontalAlignment="Left" Margin="2,12,2,2"/>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="FOCUS"><TextBlock Margin="8" Foreground="{StaticResource TextDim}" Text="Focus panel (step 8)"/></TabItem>
                        <TabItem Header="BEAM"><TextBlock Margin="8" Foreground="{StaticResource TextDim}" Text="Beam panel (step 8)"/></TabItem>
                        <TabItem Header="ALIGN"><TextBlock Margin="8" Foreground="{StaticResource TextDim}" Text="Align panel (step 8)"/></TabItem>
                        <TabItem Header="VACUUM"><TextBlock Margin="8" Foreground="{StaticResource TextDim}" Text="Vacuum panel (step 8)"/></TabItem>
                        <TabItem Header="OPTION"><TextBlock Margin="8" Foreground="{StaticResource TextDim}" Text="Environment / calibration tools (step 10)"/></TabItem>
                    </TabControl>
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>

                <Border Grid.Row="2" Style="{StaticResource Pane}">
                    <TabControl Background="{StaticResource PaneBack}" BorderThickness="0">
                        <TabItem Header="STAGE"><TextBlock Margin="8" Foreground="{StaticResource TextDim}" Text="Stage panel (step 8)"/></TabItem>
                        <TabItem Header="CFE-HV">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Port" Foreground="{StaticResource TextDim}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" x:Name="CfePortText" Text="closed" FontFamily="Consolas"/>
                                    <TextBlock Grid.Row="1" Text="Status" Foreground="{StaticResource TextDim}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CfeStatusText" Text="-" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <ListView x:Name="CfeReceiveList" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0" FontFamily="Consolas">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding [0]}"/>
                                            <GridViewColumn Header="Receive" Width="150" DisplayMemberBinding="{Binding [1]}"/>
                                            <GridViewColumn Header="Value" Width="150" DisplayMemberBinding="{Binding [2]}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="NAVI"><TextBlock Margin="8" Foreground="{StaticResource TextDim}" Text="Navigation (step 10)"/></TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
